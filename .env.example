# Copia este archivo como .env.local y completa los valores.

# URL pública final del sitio (sin diagonal al final). Se usa en SEO, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Solo si el sitio vive en una subcarpeta (p. ej. GitHub Pages: /nombre-del-repo). Vacío si usa dominio propio.
NEXT_PUBLIC_BASE_PATH=

# WhatsApp de contacto, solo dígitos con código de país. CONFIRMAR antes de publicar.
NEXT_PUBLIC_WHATSAPP=525658998321

# Correo de contacto (opcional). Si se deja vacío no se muestra.
NEXT_PUBLIC_EMAIL=

# Redes (opcional). Si se dejan vacías no se muestran.
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_FACEBOOK=

# Endpoint que recibe el formulario por POST (JSON). Compatible con Formspree, Web3Forms,
# un webhook de Make, etc. Si se deja vacío, el formulario NO simula un envío:
# arma el mensaje y lo abre en WhatsApp para que la persona lo envíe.
NEXT_PUBLIC_FORM_ENDPOINT=

# Google Analytics 4 (opcional). Solo se carga si existe este ID Y la persona acepta la medición.
NEXT_PUBLIC_GA_ID=
